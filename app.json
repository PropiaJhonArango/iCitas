{
  "expo": {
    "name": "iCitas",
    "slug": "iCitas",
    "version": "1.0.0",
    "scheme": "icitas",
    "orientation": "portrait",
    "icon": "./assets/Logo-Corazon-Redondo.png",
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#357288",
          "sounds": []
        }
      ],
      "expo-document-picker",
      [
        "expo-contacts",
        {
          "contactsPermission": "iCitas usa tus contactos para completar el nombre y teléfono del integrante."
        }
      ]
    ],
    "splash": {
      "image": "./assets/SplashPrueba.png",
      "resizeMode": "contain",
      "backgroundColor": "#047ca4"

    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.jhonarangotoro.icitas",
      "supportsTablet": true
    },
    "androidStatusBar": {
      "backgroundColor": "#357288",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.jhonarangotoro.icitas",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo-Corazon-Redondo.png",
        "backgroundColor": "#047ca4"
      },
      "config":{
        "googleMaps":{
          "apiKey":"AIzaSyBeQdmW980pxYQLHnloTm8mOknFTXUKkGE"
        }
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
